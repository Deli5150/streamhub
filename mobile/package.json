{
  "name": "streamhub-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@shopify/flash-list": "2.3.2",
    "cheerio": "^1.2.0",
    "expo": "~58.0.22",
    "expo-background-task": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "pako": "^3.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "gen": "node scripts/gen-page-scripts.mjs",
    "pretest": "node scripts/gen-page-scripts.mjs --check",
    "lint": "eslint .",
    "build:android": "EAS_NO_VCS=1 EAS_PROJECT_ROOT=.. npx eas-cli@latest build --platform android --profile preview",
    "build:ios": "EAS_NO_VCS=1 EAS_PROJECT_ROOT=.. npx eas-cli@latest build --platform ios --profile preview",
    "build:dev": "EAS_NO_VCS=1 EAS_PROJECT_ROOT=.. npx eas-cli@latest build --platform all --profile development",
    "ios:device": "expo run:ios --device --configuration Release"
  },
  "private": true
}
